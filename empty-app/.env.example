# Azure AI Foundry (필수)
AZURE_AI_FOUNDRY_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_AI_FOUNDRY_API_KEY=<your-azure-key>
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4.1-mini
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21

# LangSmith (선택). 부하테스트 중에는 false 권장.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-key>
LANGSMITH_TRACING=false

# FastAPI 안의 asyncio.Semaphore 슬롯 수
MAX_CONCURRENCY=128
